Screen {
    background: $background;
}

#app-title {
    background: $primary;
    color: $text;
    text-align: center;
    text-style: bold;
    height: 3;
    content-align: center middle;
}

#main-container {
    height: 1fr;
}

#sidebar {
    width: 28;
    display: none;
    background: $panel;
    border-right: solid $primary;
    padding: 1;
    overflow-y: auto;
}

#sidebar-title {
    text-style: bold;
    padding: 0 0 1 0;
    border-bottom: solid $primary;
    margin-bottom: 1;
}

#chat-container {
    height: 1fr;
    width: 1fr;
    background: $surface;
    border: tall $primary-muted;
    padding: 1 2;
    overflow-y: scroll;
}

ChatMessage {
    margin: 1 0;
    padding: 1 2;
    background: $background-lighten-1;
    width: 100%;
    height: auto;
}

.user-message {
    border-left: solid $accent;
    background: $boost;
}

.agent-message {
    border-left: solid $success;
}

#input-container {
    dock: bottom;
    height: auto;
    width: 100%;
    background: $background;
    padding: 1 0 0 0;
}

Input {
    border: double $primary;
    width: 100%;
    height: 3;
}
